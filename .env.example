# ── API ───────────────────────────────────────────────
# Port the NestJS API listens on. (Postgres is on 3000 here, so avoid 3000.)
PORT=5000
# Comma-separated list of allowed origins for CORS (web + app dev servers).
# Use * to allow any origin (dev only).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8081,http://localhost:19006

# Base URL of the web app (used for OAuth + password-reset redirect links).
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:5173

# ── Database (local PostgreSQL) ───────────────────────
DB_HOST=localhost
DB_PORT=3000
DB_USERNAME=rentflow
DB_PASSWORD=change-me
DB_DATABASE=rentflow

# In dev, TypeORM auto-creates/updates tables from entities.
# NEVER enable this in production — use migrations instead.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Production with Supabase Postgres (switching is env-only) ---
# Provide EITHER the discrete DB_* fields above OR a single connection string
# below (Supabase → Project → Settings → Database → Connection string / URI).
# When DATABASE_URL is set it takes precedence over the DB_* fields.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Supabase requires SSL:
# DB_SSL=true

# ── Auth ──────────────────────────────────────────────
# Use a long random string in production.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Default admin created on first boot (only if no users exist yet).
ADMIN_EMAIL=admin@rentflow.local
ADMIN_PASSWORD=admin1234

# ── OAuth: Google (OAuth 2.0 / OpenID Connect) ────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an "Authorized redirect URI" in the Google console.
#   Local: http://localhost:5000/api/auth/google/callback
#   Prod:  https://api.your-domain.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── OAuth: Facebook Login ─────────────────────────────
# Facebook Developers → your app → Settings → Basic (App ID / App Secret).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Must be listed under Facebook Login → Settings → Valid OAuth Redirect URIs.
#   Local: http://localhost:5000/api/auth/facebook/callback
#   Prod:  https://api.your-domain.com/api/auth/facebook/callback
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# ── Email (password reset) — Gmail SMTP ───────────────
# For Gmail: enable 2-Step Verification, then create an App Password
# (Google Account → Security → App passwords) and use it as SMTP_PASS.
# If these are left blank, reset links are logged to the server console (dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Rentivo <your-address@gmail.com>
